class Solution {
    public String reverseStr(String s, int k) {
        char[] arr = s.toCharArray();
        
        for (int i = 0; i < arr.length; i += 2 * k) {
            int front = i;
            int back = Math.min(i + k - 1, arr.length - 1);
            
            // Reverse the entire segment from front to back
            while (front < back) {
                char temp = arr[front];
                arr[front] = arr[back];
                arr[back] = temp;
                front++;
                back--;
            }
        }
        
        return new String(arr);
    }
}
